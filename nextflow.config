manifest {
    name            = 'crolllab/genomedenovo_nf'
    author          = 'Daniel Croll'
    description     = 'Pipeline for de novo genome assembly and BLAST-based querying'
    version         = '1.0.0'
    nextflowVersion = '>=23.0'
}

params {
    outdir = "./nf_output/"
}

workDir = './work'
process.scratch = true
cleanup = false
process.debug = false
process.executor = 'local'

singularity {
    enabled = true
    autoMounts = true
    envWhitelist = 'APPTAINERENV_NXF_TASK_WORKDIR,SINGULARITYENV_NXF_TASK_WORKDIR'
    cacheDir = "${HOME}/.singularity/cache"
}

executor {
    submitRateLimit = '240/1min'
    queueSize = 300
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

profiles {
    slurm {
        process.executor = 'slurm'
        process.cpus     = 16
    }
    local {
        process.executor = 'local'
        process.cpus     = 4
    }
    local_highCPU {
        process.executor = 'local'
        process.cpus     = 16
    }
}

process {
    withName:SPAdes {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--h8d6e82b_2'
        time = "7d"
        memory    = { 16.GB * task.attempt }

    }
    withName:SPAdesSE {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--h8d6e82b_2'
        time = "7d"
        memory    = { 16.GB * task.attempt }

    }
    withName:QUAST {
        container = 'docker://quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2'
        memory = "1 GB"
        time = "1d"
    }
    withName:BLASTsearch {
        container = 'docker://quay.io/biocontainers/blast:2.17.0--h66d330f_0'
        memory = "4 GB"
        time = "1d"
    }
    withName:SRAresolve {
        container = 'docker://quay.io/biocontainers/entrez-direct:24.0--he881be0_0'
        time      = '7d'
        cpus      = 1
        memory    = '1GB'
    }
    withName:SRAdownloadPE {
        container = 'docker://quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
        maxForks  = 10
        time      = '7d'
        cpus      = 1
        memory    = '1GB'
    }
    withName:SRAdownloadSE {
        container = 'docker://quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
        maxForks  = 10
        time      = '7d'
        cpus      = 1
        memory    = '1GB'
    }
    withName:ExtractBlastHits {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 1
        memory    = '1GB'
    }
    withName:SplitQuerySequences {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 1
        memory    = '1GB'
    }
    withName:AlignMAFFT {
        container = 'docker://quay.io/biocontainers/mafft:7.525--h031d066_1'
        time      = '1d'
        memory    = '4GB'

    }
    withName:CombineBlastHits {
        container = 'docker://quay.io/biocontainers/seqkit:2.13.0--he881be0_0'
        cpus      = 1
        time      = '1d'
        memory    = '8GB'

    }
    withName:GTHsearch {
        container = 'docker://quay.io/biocontainers/genomethreader:1.7.1--h503566f_7'
        memory    = '4GB'
        time      = '1d'
        cpus      = 1
    }
    withName:ExtractGTHCds {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '4h'
        memory    = '2GB'
    }
    withName:CombineGTHHits {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '4h'
        memory    = '2GB'
    }
    withName:AlignProteinMAFFT {
        container = 'docker://quay.io/biocontainers/mafft:7.525--h031d066_1'
        time      = '1d'
        memory    = '4GB'        
    }
    withName:PipelineStatistics {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 1
        memory    = '1GB'
    }
}