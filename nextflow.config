workDir = './work'
process.scratch = true
cleanup = false
process.debug = false

singularity {
    enabled = true
    singularity.autoMounts = true
}

profiles {
    slurm {
        process.executor    = "slurm"
        process.cpus         = 8
    }
    local {
        process.executor    = "local"
        process.cpus         = 4
    }
    local_highCPU {
        process.executor    = "local"
        process.cpus         = 24
    }
}

process {
    // Limit all processes to this concurrency by default (necessary to avoid SRA download overruns)

    withName:SRAresolve {
        container = './singularity/entrez-direct:24.0--he881be0_0'
    }
    withName:SRAdownloadPE {
        container = './singularity/sra-tools%3A3.2.1--h4304569_1'
        maxForks = 50
    }
    withName:SRAdownloadSE {
        container = './singularity/sra-tools%3A3.2.1--h4304569_1'
        maxForks = 50
    }
    withName:SPAdes {
        container = './singularity/spades%3A4.2.0--haf24da9_0'
    }
    withName:QUAST {
        container = './singularity/quast:5.3.0--py39pl5321heaaa4ec_0'
        memory = '4 GB'
        maxForks = 15  // Limit concurrent QUAST processes
    }
    withName:BLASTn {
        container = './singularity/blast%3A2.17.0--h66d330f_0'
        memory = '4 GB'
        maxForks = 10  // Limit concurrent BLAST processes to prevent memory exhaustion
    }
    withName:ExtractBlastHits {
        container = './singularity/samtools%3A1.22.1--h96c455f_0'
        memory = '2 GB'
    }
}

