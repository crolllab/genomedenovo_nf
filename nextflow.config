workDir = './work'
process.scratch = true
cleanup = false
process.debug = false

singularity {
    enabled = true
    singularity.autoMounts = true
}

profiles {
    slurm {
        process.executor    = "slurm"
        process.cpus         = 8
        process.memory       = "16 GB"
        process.time         = "4h"
        process.queue        = "def-dcroll"
        
        // SLURM-specific settings
        executor {
            queueSize = 50
            submitRateLimit = '10 sec'
        }
        
        // Process-specific SLURM resources
        process {
            withName:SPAdes {
                cpus = 16
                memory = "32 GB"
                time = "6h"
            }
            withName:SPAdesSE {
                cpus = 16
                memory = "32 GB"
                time = "6h"
            }
            withName:QUAST {
                cpus = 4
                memory = "8 GB"
                time = "1h"
            }
            withName:BLASTsearch {
                cpus = 8
                memory = "16 GB"
                time = "2h"
            }
        }
    }
    local {
        process.executor    = "local"
        process.cpus         = 4
    }
    local_highCPU {
        process.executor    = "local"
        process.cpus         = 24
    }
}

process {
    // Limit all processes to this concurrency by default (necessary to avoid SRA download overruns)

    withName:SRAresolve {
        container = './singularity/entrez-direct:24.0--he881be0_0'
    }
    withName:SplitQuerySequences {
        container = './singularity/samtools%3A1.22.1--h96c455f_0'
    }
    withName:SRAdownloadPE {
        container = './singularity/sra-tools%3A3.2.1--h4304569_1'
        maxForks = 15
    }
    withName:SRAdownloadSE {
        container = './singularity/sra-tools%3A3.2.1--h4304569_1'
        maxForks = 15
    }
    withName:SPAdes {
        container = './singularity/spades%3A4.2.0--haf24da9_0'
    }
    withName:SPAdesSE {
        container = './singularity/spades%3A4.2.0--haf24da9_0'
    }
    withName:QUAST {
        container = './singularity/quast:5.3.0--py39pl5321heaaa4ec_0'

    withName:BLASTsearch {
        container = './singularity/blast%3A2.17.0--h66d330f_0'
    }
    withName:ExtractBlastHits {
        container = './singularity/samtools%3A1.22.1--h96c455f_0'
    }
    withName:AlignMAFFT {
        container = './singularity/mafft%3A7.525--h031d066_1'
    }
    withName:SummarizeAssemblyMetrics {
        container = './singularity/quast:5.3.0--py39pl5321heaaa4ec_0'
    }
    withName:CombineBlastHits {
        container = './singularity/samtools%3A1.22.1--h96c455f_0'
    }
    withName:MergeBlastSummaries {
        container = './singularity/samtools%3A1.22.1--h96c455f_0'
    }
}

