manifest {
    name            = 'crolllab/genomedenovo_nf'
    author          = 'Daniel Croll'
    description     = 'Pipeline for de novo genome assembly and BLAST-based querying'
    version         = '1.0.0'
    nextflowVersion = '>=25.0'
}

params {
    outdir = "./nf_output/"
    // Upper bounds for any single task; requests above them (including the
    // memory that grows with each retry) are capped instead of failing to schedule.
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '7.d'
}

workDir = './work'
process.scratch = true
cleanup = false
process.debug = false
process.executor = 'local'
process.resourceLimits = [
    cpus:   params.max_cpus as int,
    memory: params.max_memory as MemoryUnit,
    time:   params.max_time as Duration
]

singularity {
    enabled = true
    autoMounts = true
    envWhitelist = 'APPTAINERENV_NXF_TASK_WORKDIR,SINGULARITYENV_NXF_TASK_WORKDIR'
    cacheDir = "${env('HOME')}/.singularity/cache"
}

executor {
    submitRateLimit = '240/1min'
    queueSize = 500
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,rss,vmem,peak_rss,peak_vmem,rchar,wchar,%cpu,%mem'
}

profiles {
    slurm {
        process.executor = 'slurm'
        process.cpus     = 16
        process.queue    = { params.slurm_queue }
    }
    local {
        process.executor = 'local'
        process.cpus     = 4
    }
    local_highCPU {
        process.executor = 'local'
        process.cpus     = 16
    }
}

process {
    withName:SPAdes {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--h8d6e82b_2'
        time = "7d"
        memory    = { 16.GB * task.attempt }

    }
    withName:SPAdesSE {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--h8d6e82b_2'
        time = "7d"
        memory    = { 16.GB * task.attempt }

    }
    withName:QUAST {
        container = 'docker://quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2'
        cpus      = 1
        memory = "1 GB"
        time = "1d"
    }
    withName:BLASTsearch {
        container = 'docker://quay.io/biocontainers/blast:2.17.0--h66d330f_0'
        // Seconds-long searches of one assembly keep ~1 core busy (measured 27% of 4)
        cpus      = 1
        memory = "4 GB"
        time = "1d"
    }
    withName:SRAresolve {
        container = 'docker://quay.io/biocontainers/entrez-direct:24.0--he881be0_0'
        time      = '7d'
        cpus      = 1
        memory    = '1GB'
    }
    withName:SRAdownloadPE {
        container = 'docker://quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
        maxForks  = 10
        time      = '7d'
        cpus      = 1
        // fasterq-dump peaks well above 1 GB on large runs (observed 1.9 GB),
        // and must scale on retry or an OOM simply re-fails identically.
        memory    = { 2.GB * task.attempt }
    }
    withName:SRAdownloadSE {
        container = 'docker://quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
        maxForks  = 10
        time      = '7d'
        cpus      = 1
        memory    = { 2.GB * task.attempt }
    }
    withName:trimSequencesPE {
        container = 'docker://quay.io/biocontainers/fastp:1.3.1--h43da1c4_0'
        maxForks  = 20
        // fastp scales poorly past ~8 threads (37% of 16 cores used), and its
        // memory grows with the thread count
        cpus      = 8
        time      = '1d'
        memory    = { 2.GB * task.attempt }
    }
    withName:trimSequencesSE {
        container = 'docker://quay.io/biocontainers/fastp:1.3.1--h43da1c4_0'
        maxForks  = 20
        cpus      = 8
        time      = '1d'
        memory    = { 2.GB * task.attempt }
    }
    withName:BLASTparalogs {
        container = 'docker://quay.io/biocontainers/blast:2.17.0--h66d330f_0'
        cpus      = 1
        memory = "4 GB"
        time = "1d"
    }
    withName:ResolveParalogs {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '1h'
        memory    = { 2.GB * task.attempt }
    }
    withName:ParalogCheck {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '1h'
        memory    = { 2.GB * task.attempt }
    }
    withName:ExtractBlastHits {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 1
        memory    = '1GB'
    }
    withName:SplitQuerySequences {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 1
        memory    = '1GB'
    }
    withName:AlignMAFFT {
        container = 'docker://quay.io/biocontainers/mafft:7.525--h031d066_1'
        time      = '1d'
        // Aligning a few thousand padded hit regions of a multi-kb gene is the heaviest step
        // here: 4,069 AvrStb9 BLAST hits (15 MB of sequence) were OOM-killed at every retry up
        // to 24 GB. Double per retry rather than adding 4 GB, capped by params.max_memory.
        memory    = { 8.GB * (2 ** (task.attempt - 1)) }
    }
    withName:CombineBlastHits {
        container = 'docker://quay.io/biocontainers/seqkit:2.13.0--he881be0_0'
        cpus      = 1
        time      = '1d'
        memory    = '2GB'

    }
    withName:ExonerateSearch {
        container = 'docker://quay.io/biocontainers/exonerate:2.4.0--hf34a1b8_9'
        memory    = '4GB'
        time      = '1d'
        cpus      = 1
    }
    withName:ExtractExonerateCds {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '4h'
        memory    = '2GB'
    }
    withName:AssessCdsIntegrity {
        container = 'docker://quay.io/biocontainers/exonerate:2.4.0--hf34a1b8_9'
        cpus      = 1
        time      = '4h'
        memory    = { 2.GB * task.attempt }
    }
    withName:CombineExonerateHits {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '4h'
        memory    = '2GB'
    }
    withName:AlignProteinMAFFT {
        container = 'docker://quay.io/biocontainers/mafft:7.525--h031d066_1'
        time      = '1d'
        memory    = { 4.GB * task.attempt }
    }
    withName:AlignExonerateCdsMAFFT {
        container = 'docker://quay.io/biocontainers/mafft:7.525--h031d066_1'
        time      = '1d'
        memory    = { 4.GB * task.attempt }
    }
    withName:MergeExonerateSummaries {
        container = 'docker://quay.io/biocontainers/seqkit:2.13.0--he881be0_0'
        cpus      = 1
        time      = '1h'
        memory    = '2GB'
    }
    withName:SummarizeIsoforms {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '1h'
        memory    = '2GB'
    }
    withName:SummarizeHitTEs {
        container = 'docker://quay.io/biocontainers/spades:4.2.0--haf24da9_0'
        cpus      = 1
        time      = '1h'
        memory    = { 2.GB * task.attempt }
    }
    withName:PlotIsoformTree {
        // R + ape (ggtree itself is not used)
        container = 'docker://quay.io/biocontainers/bioconductor-ggtree:4.0.4--r45hdfd78af_1'
        cpus      = 1
        time      = '1h'
        memory    = '2GB'
    }
    withName:RepeatMasker {
        container = 'docker://quay.io/biocontainers/repeatmasker:4.2.3--pl5321hdfd78af_0'
        // One RMBlast batch runs 4 threads; the module sets -pa to cpus / 4
        cpus      = 4
        time      = '2d'
        memory    = { 4.GB * task.attempt }
    }
    withName:bwaIndex {
        container = 'docker://quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0'
        cpus      = 1
        time      = '4h'
        memory    = { 8.GB * task.attempt }
    }
    withName:bwaMap {
        container = 'docker://quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0'
        time      = '2d'
        memory    = { 8.GB * task.attempt }
    }
    withName:samtoolsSort {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 4
        memory    = { 4.GB * task.attempt }
    }
    withName:SummarizeFastpStats {
        container = 'docker://rocker/tidyverse:4.4.3'
        cpus      = 1
        time      = '1h'
        memory    = '2GB'
    }
    withName:PipelineStatistics {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        time      = '4h'
        cpus      = 1
        memory    = '1GB'
    }
    withName:AlignBuscoGene {
        container = 'docker://quay.io/biocontainers/mafft:7.525--h031d066_1'
        // Single-gene alignments finish in seconds
        cpus      = 4
        time      = '1d'
        memory    = { 2.GB * task.attempt }
    }
    withName:BuildSupermatrix {
        container = 'docker://quay.io/biocontainers/busco:6.0.0--pyhdfd78af_3'
        cpus      = 1
        time      = '12h'
        memory    = '2GB'
    }
    withName:RaxmlNgPhylogeny {
        container = 'docker://quay.io/biocontainers/raxml-ng:2.0.2--h870a6a7_0'
        time      = '2d'
        // Measured peak 3 GB for the full BUSCO supermatrix
        memory    = { 8.GB * task.attempt }
    }
    withName:IQtreePhylogeny {
        container = 'docker://quay.io/biocontainers/iqtree:3.1.2--h8471819_0'
        time      = '2d'
        memory    = { 16.GB * task.attempt }
    }
    withName: 'IQtreeBlastPhylogeny|IQtreeCdsPhylogeny|IQtreeProteinPhylogeny|IQtreeCdsIsoformPhylogeny|IQtreeProteinIsoformPhylogeny' {
        container = 'docker://quay.io/biocontainers/iqtree:3.1.2--h8471819_0'
        // Single-gene trees; the module lets IQ-TREE pick up to this many threads (-T AUTO)
        cpus      = 4
        time      = '1d'
        memory    = { 8.GB * task.attempt }
    }
    withName:DownloadBUSCODatabase {
        container = 'docker://quay.io/biocontainers/busco:6.0.0--pyhdfd78af_3'
        cpus      = 1
        memory    = { 8.GB * task.attempt }
        time      = '2d'
    }
    withName:BUSCO {
        container = 'docker://quay.io/biocontainers/busco:6.0.0--pyhdfd78af_3'
        // CPU-bound (96% of 2 cores) and peaked at the old 4 GB limit
        cpus      = 8
        memory    = { 8.GB * task.attempt }
        time      = '2d'
    }
    withName:SummarizeBuscoMetrics {
        container = 'docker://quay.io/biocontainers/busco:6.0.0--pyhdfd78af_3'
        cpus      = 1
        time      = '1h'
        memory    = '1GB'
    }
    withName:BlastLocusOnReference {
        container = 'docker://quay.io/biocontainers/blast:2.17.0--h66d330f_0'
        cpus      = 1
        time      = '4h'
        memory    = { 4.GB * task.attempt }
    }
    withName:ComputeLocusCoverage {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        cpus      = 1
        time      = '4h'
        memory    = { 4.GB * task.attempt }
    }
    withName:MergeLocusCoverage {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        cpus      = 1
        time      = '1h'
        memory    = '1GB'
    }
    withName:SummarizeAssemblyMetrics {
        container = 'docker://quay.io/biocontainers/quast:5.3.0--py313pl5321h5ca1c30_2'
        cpus      = 1
        time      = '1h'
        memory    = '1GB'
    }
    withName:MergeBlastSummaries {
        container = 'docker://quay.io/biocontainers/samtools:1.23.1--ha83d96e_0'
        cpus      = 1
        time      = '1h'
        memory    = '1GB'
    }
    withName:SummarizeBwaStats {
        container = 'docker://rocker/tidyverse:4.4.3'
        cpus      = 1
        time      = '1h'
        memory    = '1GB'
    }
}