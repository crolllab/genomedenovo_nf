workDir = './work'
process.scratch = true
cleanup = false
process.debug = false

singularity {
    enabled = true
    singularity.autoMounts = true
}

profiles {
    slurm {
        process.executor    = "slurm"
        process.cpus         = 8
    }
    local {
        process.executor    = "local"
        process.cpus         = 4
    }
    local_highCPU {
        process.executor    = "local"
        process.cpus         = 24
    }
}

process {
    // Limit all processes to this concurrency by default (necessary to avoid SRA download overruns)

    withName:SRAresolve {
        container = './singularity/entrez-direct:24.0--he881be0_0'
    }
    withName:SRAdownloadPE {
        container = './singularity/sra-tools%3A3.2.1--h4304569_1'
        maxForks = 50
    }
    withName:SRAdownloadSE {
        container = './singularity/sra-tools%3A3.2.1--h4304569_1'
        maxForks = 50
    }
https://depot.galaxyproject.org/singularity/spades%3A4.2.0--haf24da9_0
}

